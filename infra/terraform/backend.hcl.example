# Copy to backend.hcl (gitignored) and fill in the values printed by
# `terraform apply` in infra/terraform/bootstrap/.
#
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl

bucket         = "motacare-terraform-state"
key            = "motacare/main.tfstate"
region         = "us-east-1"
dynamodb_table = "motacare-terraform-lock"
encrypt        = true
